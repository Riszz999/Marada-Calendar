# ---- Server ----
PORT=4000
# ผูกกับ loopback เท่านั้น ให้ nginx เป็นทางเข้าเดียว
# ถ้าตั้งเป็น 0.0.0.0 คนภายนอกจะยิงตรงพอร์ตนี้ข้าม nginx แล้วปลอม X-Forwarded-For ได้
BIND_HOST=127.0.0.1

# development หรือ production
# ตั้งเป็น production แล้วระบบจะ "ปฏิเสธการเริ่มทำงาน" ถ้ายังใช้ค่าตัวอย่างด้านล่าง
NODE_ENV=development

# เชื่อ X-Forwarded-For กี่ชั้น — เว้นว่างไว้จะได้ค่าที่เหมาะกับ NODE_ENV เอง
# (production = 1 ชั้นคือ nginx, development = ไม่เชื่อเลย)
# สำคัญ: ค่านี้จะปลอดภัยก็ต่อเมื่อมีแต่ nginx เท่านั้นที่ต่อพอร์ต API ได้ (BIND_HOST + firewall)
# TRUST_PROXY=1

# บน production ต้องเป็นโดเมนจริงและขึ้นต้นด้วย https://
CLIENT_ORIGIN=http://localhost:5173

# ---- MySQL (ตรงกับ docker-compose.yml) ----
DB_HOST=127.0.0.1
DB_PORT=3308
DB_USER=reservation
DB_PASSWORD=reservation_pw
DB_NAME=reservation_calendar

# ---- Admin ----
# บัญชีผู้ดูแลเก็บอยู่ในตาราง admin_users ของฐานข้อมูล ไม่ได้อยู่ในไฟล์นี้
# สองค่าล่างนี้ใช้ "เฉพาะตอนบูตครั้งแรก" เท่านั้น คือตอนที่ตาราง admin_users ยังว่าง
# หลังจากนั้นให้เปลี่ยนชื่อผู้ใช้/รหัสผ่านจากหน้าเว็บ (เมนู "ตั้งค่าบัญชี")
#
# สร้าง hash ด้วย:  npm run hash-password -- "รหัสผ่านของคุณ"
BOOTSTRAP_ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2a$10$replace-me-with-your-own-hash

# ต้องเป็นค่าสุ่มยาว ๆ — สร้างด้วย:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# เปลี่ยนค่านี้ = token ที่ออกไปแล้วทุกใบใช้ไม่ได้ทันที (ทุกคนต้องล็อกอินใหม่)
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=8h

# ---- รหัสเข้าถึงสำหรับพนักงาน ----
# ตัวรหัสเก็บอยู่ในตาราง staff_key ของฐานข้อมูล ไม่ได้อยู่ในไฟล์นี้
# แอดมินตั้ง/เปลี่ยน/ปิดได้จากหน้าเว็บ (เมนู "รหัสพนักงาน")
# ค่าล่างนี้คุมแค่ว่าเครื่องพนักงานจะจำรหัสไว้นานแค่ไหนก่อนต้องกรอกใหม่
STAFF_TOKEN_EXPIRES_IN=30d
